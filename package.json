{
  "name": "food-delivery-startup-system",
  "version": "1.0.0",
  "description": "Modular OOP food delivery system: customers, menu, multi-item orders, payments, deliveries, and completed transactions. CLI-only, SQLite (WAL) persistence.",
  "keywords": [
    "food-delivery",
    "oop",
    "sqlite",
    "cli",
    "better-sqlite3"
  ],
  "author": "TheoRiesu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoRiesu/FoodDeliveryStartupSystem.git"
  },
  "bugs": {
    "url": "https://github.com/TheoRiesu/FoodDeliveryStartupSystem/issues"
  },
  "homepage": "https://github.com/TheoRiesu/FoodDeliveryStartupSystem#readme",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "tui": "node --experimental-ffi src/index.js tui",
    "dev": "node --watch src/index.js",
    "seed:menu": "node scripts/seed-menu.js",
    "lint": "prettier --check . && eslint .",
    "prettier-write": "prettier --write ."
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": ">=26.4"
  },
  "dependencies": {
    "@opentui/core": "0.5.10",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  }
}
